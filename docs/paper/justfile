default: build

all: clean tables build

build:
    pdflatex -interaction=nonstopmode main
    bibtex main
    pdflatex -interaction=nonstopmode main
    pdflatex -interaction=nonstopmode main

clean:
    rm -f main.aux main.bbl main.blg main.log main.out main.pdf main.fls main.fdb_latexmk main.synctex.gz

rebuild: clean build

tables:
    uv run python scripts/generate_tables.py
