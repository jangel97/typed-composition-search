{% if graph_structure %}
<div class="card">
  <h3>Graph Structure by Domain</h3>
  <table>
    <tr>
      <th>Metric</th>
      {% for d in graph_structure.domains %}
      <th class="strategy">{{ d }}</th>
      {% endfor %}
    </tr>
    {% for row in graph_structure.rows %}
    <tr>
      <td class="label">{{ row.label }}</td>
      {% for val in row["values"] %}
      {% if val is number and val is float %}
      <td class="val">{{ "%.2f"|format(val) }}</td>
      {% else %}
      <td class="val">{{ val }}</td>
      {% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
  </table>
  {% if graph_structure.betweenness %}
  <h4 style="margin-top:16px; color:#9ca3af; font-size:12px;">Top Betweenness Centrality (hub types)</h4>
  <table>
    <tr><th>Domain</th><th style="text-align:left">Top Types</th></tr>
    {% for b in graph_structure.betweenness %}
    <tr><td class="label">{{ b.domain }}</td><td class="val" style="text-align:left">{{ b.items }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
</div>
{% endif %}
