{% if summary %}
{% set s = summary %}
<div class="card summary-card">
  <h3>Best Graph Strategy vs Baseline</h3>
  <div class="summary-subtitle">Winner: <strong>{{ s.best_key }}</strong> (F1 = {{ "%.2f"|format(s.best_f1) }})</div>
  <div class="summary-grid">
    <div class="summary-item">
      <div class="summary-value {{ 'pos' if s.rec_delta >= 0 else 'neg' }}">{{ s.rec_delta|delta_sign }}{{ "%.2f"|format(s.rec_delta) }}</div>
      <div class="summary-label">Recall</div>
      <div class="summary-detail">{{ "%.2f"|format(s.bl_rec) }} &rarr; {{ "%.2f"|format(s.best_rec) }}</div>
    </div>
    <div class="summary-item">
      <div class="summary-value {{ 'pos' if s.prec_delta >= 0 else 'neg' }}">{{ s.prec_delta|delta_sign }}{{ "%.2f"|format(s.prec_delta) }}</div>
      <div class="summary-label">Precision</div>
      <div class="summary-detail">{{ "%.2f"|format(s.bl_prec) }} &rarr; {{ "%.2f"|format(s.best_prec) }}</div>
    </div>
    <div class="summary-item">
      <div class="summary-value {{ 'pos' if s.f1_delta >= 0 else 'neg' }}">{{ s.f1_delta|delta_sign }}{{ "%.2f"|format(s.f1_delta) }}</div>
      <div class="summary-label">F1</div>
      <div class="summary-detail">{{ "%.2f"|format(s.bl_f1) }} &rarr; {{ "%.2f"|format(s.best_f1) }}</div>
    </div>
    <div class="summary-item">
      <div class="summary-value pos">{{ s.best_hall }}</div>
      <div class="summary-label">Hallucinations</div>
      <div class="summary-detail">baseline: {{ s.bl_hall }}</div>
    </div>
    <div class="summary-item">
      <div class="summary-value {{ 'pos' if s.tok_pct > 0 else 'neg' }}">{{ "%.0f"|format(s.tok_pct) }}%</div>
      <div class="summary-label">Token savings</div>
      <div class="summary-detail">{{ "%.0f"|format(s.bl_tok) }} &rarr; {{ "%.0f"|format(s.best_tok) }} avg</div>
    </div>
  </div>
</div>
{% endif %}
